CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=2048
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=98304
CONFIG_SPIRAM_MEMTEST=n
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=3
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_RX_BA_WIN=3
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=16
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y

CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# -O2: the LVGL/emote/TFLM hot paths are compiled code, and the app slot
# has more than a megabyte of slack to trade for speed.
CONFIG_COMPILER_OPTIMIZATION_PERF=y

CONFIG_SR_WN_WN9_NIHAOXIAOZHI_TTS=y

CONFIG_USE_MICRO_WAKE_WORD=y
# The current "Hey, Apólo" model evaluates at ~68% recall; 50 is its usable
# operating point. Raise toward 90 when a stronger model lands.
CONFIG_MICRO_WAKE_WORD_PROBABILITY_CUTOFF=50

CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=1536

# LVGL Graphics
CONFIG_LV_USE_SNAPSHOT=y

CONFIG_VOICEMODE_PROTOCOL=y
# These two decide whether a call is a conversation or a single exchange, so
# they belong here rather than in a file ESP-IDF does not read.
#
# USE_DEVICE_AEC switches the device to the full-duplex listening mode: the
# microphone stays open while the assistant speaks, and the call runs until
# the person ends it. Without it the device closes the microphone during a
# reply and hangs up about a second after the person stops talking - correct
# for the press-to-talk design this was forked from, wrong for a call.
#
# They used to live in sdkconfig.defaults.codex-voice. Nothing loads that name
# automatically, so they survived only in each developer's own generated
# sdkconfig. Delete that file and the next build silently produced a device in
# the wrong mode, with no error to explain it. That cost one evening.
CONFIG_VOICEMODE_CODEX_VOICE=y
CONFIG_USE_DEVICE_AEC=y
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_MBEDTLS_SSL_PROTO_DTLS=y
CONFIG_MBEDTLS_SSL_DTLS_SRTP=y
CONFIG_MBEDTLS_X509_CREATE_C=y
